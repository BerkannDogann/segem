{"questions":[{"id":"q1","topicId":"sureler","text":"Trafik sigortasında sigortalının kazayı şirkete ihbar süresi nedir?","options":["5 iş günü","8 iş günü","10 gün","15 gün"],"answer":2,"explanation":"Trafikte ihbar süresi 10 gündür. 5 iş günü kaskodaki ihbar süresidir."},{"id":"q2","topicId":"sureler","text":"Gerekli belgeler iletildikten sonra trafik sigortasında ödeme süresi kaç gündür?","options":["2 iş günü","8 iş günü","10 iş günü","15 gün"],"answer":1,"explanation":"Trafikte ödeme 8 iş günüdür; kaskoda 10 iş günüdür."},{"id":"q3","topicId":"sureler","text":"Dava öncesi yazılı başvuruda sigorta şirketinin cevap vermesi için tanınan süre nedir?","options":["8 gün","10 gün","15 gün","30 gün"],"answer":2,"explanation":"Şirketin dava öncesi başvuruya cevap süresi 15 gündür."},{"id":"q4","topicId":"sureler","text":"Anlaşmalı servis bildirimi ihbardan itibaren hangi süre içinde yapılmalıdır?","options":["24 saat","2 iş günü","5 iş günü","10 gün"],"answer":1,"explanation":"Anlaşmalı servis bildirimi ihbardan itibaren 2 iş günü içinde yapılır."},{"id":"q5","topicId":"sureler","text":"Trafik sigortasında zamanaşımı süresi hangisidir?","options":["Kazadan itibaren 1 yıl","Öğrenmeden 2 yıl, her halde kazadan 10 yıl","Öğrenmeden 5 yıl","Kazadan itibaren 2 yıl, her halde 5 yıl"],"answer":1,"explanation":"Zamanaşımı öğrenmeden itibaren 2 yıl, her halde kazadan itibaren 10 yıldır."},{"id":"q6","topicId":"sureler","text":"Kasko sigortasında ihbar ve ödeme süreleri sırasıyla hangisidir?","options":["10 gün / 8 iş günü","5 iş günü / 10 iş günü","5 gün / 15 gün","2 iş günü / 8 iş günü"],"answer":1,"explanation":"Kaskoda ihbar 5 iş günü, ödeme 10 iş günüdür. Trafik süreleriyle karıştırılmamalıdır."},{"id":"q7","topicId":"basamak","text":"Bir yıl boyunca hasarsız geçen işletenin basamağı nasıl değişir?","options":["Değişmez","Bir üst basamağa çıkar","İki üst basamağa çıkar","En üst basamağa çıkar"],"answer":1,"explanation":"Hasarsız geçen her yıl bir üst basamak demektir."},{"id":"q8","topicId":"basamak","text":"Sakatlanma veya ölüm nedeniyle ödeme yapılan poliçede basamak kaç kademe düşer?","options":["Bir","İki","Üç","Düşmez"],"answer":1,"explanation":"Maddi ödeme bir, sakatlanma veya ölüm ödemesi iki basamak düşürür."},{"id":"q9","topicId":"basamak","text":"Araç satıldığında hasarsızlık basamağına ne olur?","options":["Basamak araçla birlikte yeni sahibe geçer","Basamak sıfırlanır ve araç başlangıç basamağına döner","Basamak işleteni takip eder; yeni sahibe geçmez","Satıcı ve alıcı basamağı paylaşır"],"answer":2,"explanation":"Basamak işleteni takip eder, aracı değil. Her işletenin kendi geçmişi esastır."},{"id":"q10","topicId":"tavan-prim","text":"Sigorta şirketleri trafik sigortası primini nasıl belirler?","options":["Tüm Türkiye için tek tarife uygular","İl bazında serbestçe belirler ancak tavanı aşamaz","Tavanın altına inemez","Primi yalnızca aracın yaşına göre belirler"],"answer":1,"explanation":"Şirket il bazında primi serbest belirler; tavan prim üst sınırdır."},{"id":"q11","topicId":"tavan-prim","text":"Tavan prim her ay neye göre güncellenir?","options":["TÜFE","Hasar maliyet endeksi","Döviz kuru","Asgari ücret artışı"],"answer":1,"explanation":"Tavan her ay hasar maliyet endeksine göre artar. Endeksteki en ağır kalem asgari ücrettir (%45)."},{"id":"q12","topicId":"tavan-prim","text":"Hasar maliyet endeksi negatif çıkarsa tavan prim için ne uygulanır?","options":["Tavan aynı oranda düşer","Oran sıfır kabul edilir, tavan düşmez","Bir önceki ayın artış oranı uygulanır","Tavan %5 düşürülür"],"answer":1,"explanation":"Negatif endekste tavan düşmez; oran sıfır kabul edilir."},{"id":"q13","topicId":"tavan-prim","text":"Poliçe geç yenilendiğinde uygulanacak ilave prim hangisidir?","options":["Her 15 günde %5, en çok %25","Her 30 günde %5, en çok %50","Her 30 günde %10, sınırsız","Tek seferlik %20"],"answer":1,"explanation":"Geç yenilemede her 30 gün için %5, en çok %50 ilave uygulanır."},{"id":"q14","topicId":"tavan-prim","text":"Gerçek kişi aynı araç grubunda kaç araca kadar özel kişi tarifesinden yararlanır?","options":["Üç","Dört","Beş","Sınırsız"],"answer":2,"explanation":"Gerçek kişide aynı araç grubunda beş araca kadar özel; sonrası tüzel tarifeden fiyatlanır."},{"id":"q15","topicId":"hasar-tazminat","text":"Trafik sigortasında parça değişiminden doğan kıymet artışı için hangisi doğrudur?","options":["Tazminattan tamamen düşülür","Tazminattan yarı oranında düşülür","Tazminattan düşülmez","Yalnızca ağır hasarda düşülür"],"answer":2,"explanation":"Trafik sigortasında parça değişiminden doğan kıymet artışı tazminattan düşülmez."},{"id":"q16","topicId":"hasar-tazminat","text":"Ağır hasarlı araçta hangi belge aranır?","options":["Ekspertiz raporu yeterlidir","“Trafikten çekilmiştir” kaşeli tescil belgesi","Noter satış sözleşmesi","Muayene raporu"],"answer":1,"explanation":"Ağır hasarda “trafikten çekilmiştir” kaşeli tescil belgesi aranır."},{"id":"q17","topicId":"saglik-sgk","text":"Trafik kazasından kaynaklanan tedavi giderlerini kim karşılar?","options":["Kusurlu sürücü","Sigorta şirketi doğrudan","SGK","Güvence Hesabı"],"answer":2,"explanation":"Trafik kazası kaynaklı tedavi giderleri SGK tarafından karşılanır."},{"id":"q18","topicId":"sigortasizlik","text":"Sigortasız bir aracın verdiği zararı sınırlar dahilinde kim öder?","options":["SGK","Güvence Hesabı","Karayolları Genel Müdürlüğü","Hiçbir kurum ödemez"],"answer":1,"explanation":"Sigortasız veya tespit edilemeyen araçların verdiği zararları Güvence Hesabı öder."},{"id":"q19","topicId":"ilkeler","text":"Tarafların sözleşme öncesinde riskle ilgili bildikleri her şeyi doğru beyan etmesini öngören ilke hangisidir?","options":["Halefiyet","Azami iyi niyet","Yakın sebep","Katılım"],"answer":1,"explanation":"Azami iyi niyet ilkesi tarafların riskle ilgili önemli bilgileri eksiksiz ve doğru beyan etmesini gerektirir."},{"id":"q20","topicId":"ilkeler","text":"Sigortalının zarardan zenginleşmemesi gerektiğini ifade eden ilke hangisidir?","options":["Tazminat ilkesi","Sigortalanabilir menfaat","Azami iyi niyet","Riskin dağıtılması"],"answer":0,"explanation":"Tazminat ilkesine göre sigortalıya gerçek zararından fazlası ödenmez."},{"id":"q21","topicId":"ilkeler","text":"Tazminatı ödeyen sigortacının, ödediği oranda sigortalının zarardan sorumlu kişiye karşı haklarına geçmesine ne denir?","options":["Retrosesyon","Muafiyet","Halefiyet (rücu)","Temlik"],"answer":2,"explanation":"Sigortacı ödediği tazminat oranında sigortalının haklarına halef olur ve sorumluya rücu edebilir."},{"id":"q22","topicId":"ilkeler","text":"Bir kişinin bir malı sigortalayabilmesi için o malla ilgili hangi şart aranır?","options":["Malın sahibi olması zorunludur","Malın zarar görmesinden ekonomik olarak etkilenmesi","Malın yeni olması","Malın değerinin belirli bir tutarı aşması"],"answer":1,"explanation":"Sigortalanabilir menfaat için kişinin malın zarar görmesinden ekonomik olarak etkilenmesi yeterlidir; mülkiyet şart değildir."},{"id":"q23","topicId":"kavramlar","text":"Aşağıdakilerden hangisi rizikonun özelliklerinden biri değildir?","options":["Gelecekte gerçekleşmesi muhtemel olmalı","Gerçekleşip gerçekleşmeyeceği belirsiz olmalı","Sigortalının iradesine bağlı olmalı","Ekonomik bir zarara yol açabilmeli"],"answer":2,"explanation":"Riziko sigortalının iradesine bağlı olmamalıdır; kasten gerçekleştirilen olay riziko sayılmaz."},{"id":"q24","topicId":"kavramlar","text":"Değeri 1.000.000 TL olan bina 500.000 TL bedelle sigortalanmış ve 200.000 TL zarar oluşmuştur. Aksine sözleşme yoksa ödenecek tazminat nedir?","options":["50.000 TL","100.000 TL","200.000 TL","500.000 TL"],"answer":1,"explanation":"Eksik sigorta: bedel/değer oranı 500.000 / 1.000.000 = 1/2. Tazminat 200.000 × 1/2 = 100.000 TL.","source":"TTK m.1462 (eksik sigorta)"},{"id":"q25","topicId":"kavramlar","text":"Sigorta bedelinin sigorta değerini aştığı duruma ne ad verilir?","options":["Eksik sigorta","Aşkın sigorta","Müşterek sigorta","Reasürans"],"answer":1,"explanation":"Bedelin değerden yüksek olduğu duruma aşkın sigorta denir; yine de gerçek zarardan fazlası ödenmez."},{"id":"q26","topicId":"kavramlar","text":"Zararın poliçede belirlenen ve sigortalı üzerinde kalan kısmına ne denir?","options":["Prim","Muafiyet","Teminat limiti","Hasar frekansı"],"answer":1,"explanation":"Muafiyet, zararın sigortacı tarafından ödenmeyen ve sigortalıda kalan kısmıdır."},{"id":"q27","topicId":"ttk-sureler","text":"TTK’ya göre sigorta tazminatı, her hâlde ihbardan itibaren kaç gün sonra muaccel olur?","options":["15 gün","30 gün","45 gün","60 gün"],"answer":2,"explanation":"Tazminat, araştırmalar bitince ve her hâlde ihbardan 45 gün sonra muaccel olur.","source":"TTK m.1427"},{"id":"q28","topicId":"ttk-sureler","text":"TTK m.1420’ye göre sigorta tazminatına ilişkin istemler her hâlde rizikonun gerçekleştiği tarihten itibaren kaç yılda zamanaşımına uğrar?","options":["2 yıl","5 yıl","6 yıl","10 yıl"],"answer":2,"explanation":"Genel kural: muacceliyetten 2 yıl, her hâlde rizikodan 6 yıl.","source":"TTK m.1420"},{"id":"q29","topicId":"ttk-sureler","text":"Tazminat muaccel olduğunda sigortacının temerrüde düşmesi için ne gerekir?","options":["Noter ihtarı","Dava açılması","Hiçbir şey; ihtara gerek yoktur","Tahkim başvurusu"],"answer":2,"explanation":"Tazminat alacağı muaccel olunca sigortacı ihtara gerek kalmaksızın temerrüde düşer.","source":"TTK m.1427/4"},{"id":"q30","topicId":"ttk-sureler","text":"TTK’ya göre sigorta ettiren rizikonun gerçekleştiğini öğrenince sigortacıya ne zaman bildirmelidir?","options":["24 saat içinde","Gecikmeksizin","30 gün içinde","Poliçe bitiminde"],"answer":1,"explanation":"TTK genel kuralı gecikmeksizin ihbardır; branşlara özgü süreler genel şartlarda düzenlenir.","source":"TTK m.1446"},{"id":"q31","topicId":"reasurans","text":"Reasürans en kısa hâliyle nasıl tanımlanır?","options":["Sigortalının ikinci bir poliçe alması","Sigortacının sigortalanması","Primin taksitlendirilmesi","Acentenin komisyon devri"],"answer":1,"explanation":"Reasürans, sigorta şirketinin üstlendiği riskin bir kısmını reasüröre devretmesidir; sigortacının sigortasıdır."},{"id":"q32","topicId":"reasurans","text":"Riskini reasüröre devreden sigorta şirketine ne ad verilir?","options":["Sedan","Retrosesyoner","Broker","Koasürör"],"answer":0,"explanation":"Riski devreden şirket sedan (ceding company) olarak adlandırılır."},{"id":"q33","topicId":"reasurans","text":"Reasürörün kabul ettiği riski başka bir reasüröre devretmesine ne denir?","options":["Koasürans","Retrosesyon","Kotpar","Halefiyet"],"answer":1,"explanation":"Reasürörün reasüransına retrosesyon denir."},{"id":"q34","topicId":"reasurans","text":"Aşağıdakilerden hangisi orantısız (nonproporsiyonel) reasürans türüdür?","options":["Kotpar","Eksedan","Hasar fazlası (excess of loss)","Kotpar-eksedan karma"],"answer":2,"explanation":"Kotpar ve eksedan orantılı; hasar fazlası ve stop loss orantısız reasürans türleridir."},{"id":"q35","topicId":"sigorta-turleri","text":"Aşağıdakilerden hangisi zorunlu sigortadır?","options":["Kasko","Ferdi kaza","Zorunlu deprem sigortası (DASK)","Konut paket sigortası"],"answer":2,"explanation":"Zorunlu deprem sigortası kanunla zorunlu tutulmuştur; diğerleri ihtiyaridir."},{"id":"q36","topicId":"sigorta-turleri","text":"Zorunlu deprem sigortası hangi kanuna dayanır?","options":["5684 sayılı Sigortacılık Kanunu","6305 sayılı Afet Sigortaları Kanunu","2918 sayılı KTK","6102 sayılı TTK"],"answer":1,"explanation":"Zorunlu deprem sigortası 6305 sayılı Afet Sigortaları Kanunu ile düzenlenmiştir."},{"id":"q37","topicId":"sigorta-turleri","text":"Kendi kusuruyla kaza yapan sürücünün aracındaki hasarı hangi sigorta karşılar?","options":["Trafik sigortası","Kasko sigortası","Güvence Hesabı","Ferdi kaza sigortası"],"answer":1,"explanation":"Aracın kendi zararını kasko karşılar; trafik sigortası yalnızca üçüncü kişilere verilen zararı öder."},{"id":"q38","topicId":"kurumlar","text":"Türkiye’de sigortacılık sektörünü düzenleyen ve denetleyen kurum hangisidir?","options":["SPK","BDDK","SEDDK","TOBB"],"answer":2,"explanation":"Sigortacılık ve Özel Emeklilik Düzenleme ve Denetleme Kurumu (SEDDK) sektörün düzenleyici ve denetleyicisidir."},{"id":"q39","topicId":"kurumlar","text":"5684 sayılı Sigortacılık Kanunu’na göre sigorta şirketleri hangi şirket türlerinde kurulabilir?","options":["Limited veya anonim","Anonim veya kooperatif","Yalnızca kooperatif","Kollektif veya komandit"],"answer":1,"explanation":"Sigorta ve reasürans şirketleri anonim şirket veya kooperatif şirket olarak kurulur.","source":"5684 sayılı Kanun m.3"},{"id":"q40","topicId":"kurumlar","text":"Sigorta ettirenle sigorta şirketi arasındaki uyuşmazlıkları çözmek için kurulan yapı hangisidir?","options":["Güvence Hesabı","Sigorta Tahkim Komisyonu","Sigorta Bilgi ve Gözetim Merkezi","TARSİM"],"answer":1,"explanation":"Sigorta Tahkim Komisyonu, sigorta sözleşmesinden doğan uyuşmazlıkları çözmek için kurulmuştur."},{"id":"q41","topicId":"kurumlar","text":"Sigorta sözleşmesine ilişkin genel hükümler hangi kanunda yer alır?","options":["Türk Borçlar Kanunu","Türk Ticaret Kanunu","Tüketici Kanunu","Bankacılık Kanunu"],"answer":1,"explanation":"Sigorta sözleşmesi hükümleri 6102 sayılı TTK’nın altıncı kitabında (m.1401 vd.) düzenlenir."},{"id":"q42","topicId":"acente","text":"Acentede sigorta ürünlerinin pazarlama, bilgilendirme ve satış işlemlerini kim yapabilir?","options":["Acentenin tüm çalışanları","Yalnızca teknik personel","Yalnızca acente sahibi","Sigorta eksperi"],"answer":1,"explanation":"SEGEM kılavuzuna göre bu işlemler yalnızca teknik personel tarafından yapılır.","source":"SEGEM TPYS 2026 Kılavuzu; Sigorta Acenteleri Yönetmeliği"},{"id":"q43","topicId":"acente","text":"Sigorta acentelerinin faaliyet için kayıtlı olması gereken levha hangi kuruluş nezdinde tutulur?","options":["SEDDK","Türkiye Sigorta Birliği","TOBB","Ticaret Bakanlığı"],"answer":2,"explanation":"Acenteler Türkiye Odalar ve Borsalar Birliği (TOBB) nezdindeki levhaya kaydolur."},{"id":"q44","topicId":"acente","text":"Müşterilerin kişisel verilerinin işlenmesinde uyulması gereken temel kanun hangisidir?","options":["5684 sayılı Kanun","6698 sayılı KVKK","5549 sayılı Kanun","6502 sayılı Kanun"],"answer":1,"explanation":"Kişisel verilerin işlenmesi 6698 sayılı Kişisel Verilerin Korunması Kanunu’na tabidir."},{"id":"q45","topicId":"dijital","text":"Web sitesinin arama motorlarında ücretsiz (organik) sonuçlarda üst sıralara çıkmasını hedefleyen çalışma hangisidir?","options":["SEO","CRM","KPI","B2B"],"answer":0,"explanation":"SEO (arama motoru optimizasyonu) organik görünürlüğü artırmayı hedefler."},{"id":"q46","topicId":"dijital","text":"1.000 ziyaretçiden 50’si teklif formu doldurmuştur. Dönüşüm oranı nedir?","options":["%0,5","%5","%20","%50"],"answer":1,"explanation":"Dönüşüm oranı = 50 / 1.000 = %5."},{"id":"q47","topicId":"iletisim-becerileri","text":"Müşteriyi sözünü kesmeden dinleyip söylediklerini özetleyerek geri bildirmek hangi beceriye örnektir?","options":["İkna","Etkin dinleme","Tek yönlü iletişim","Savunmacı iletişim"],"answer":1,"explanation":"Etkin dinleme; dikkatle dinlemeyi, anladığını özetlemeyi ve geri bildirim vermeyi kapsar."},{"id":"q48","topicId":"iletisim-becerileri","text":"Hasar ödemesi gecikmiş, öfkeli bir müşteriye karşı ilk yapılması gereken hangisidir?","options":["Haklı olmadığını hemen açıklamak","Duygusunu kabul edip dinlemek","Görüşmeyi başka güne ertelemek","Konuyu şirkete yönlendirip kapatmak"],"answer":1,"explanation":"Empatik yaklaşım önce duyguyu kabul edip dinlemeyi, ardından çözüm üretmeyi gerektirir."},{"id":"q49","topicId":"kurumsal","text":"Paydaşların bir kurum hakkında zaman içinde oluşan genel algı ve değerlendirmesine ne denir?","options":["Kurumsal kimlik","Kurumsal itibar","Logo","Pazar payı"],"answer":1,"explanation":"Kurumsal itibar, paydaşların kuruma ilişkin birikmiş algısıdır; kimlik ise kurumun kendini nasıl tanımladığıdır."},{"id":"q50","topicId":"kurumsal","text":"Kriz anında kurumsal iletişimde hangi yaklaşım doğrudur?","options":["Bilgi tamamlanana kadar sessiz kalmak","Hızlı, tutarlı ve şeffaf bilgi vermek","Her birimin ayrı açıklama yapması","Sorumluluğu üçüncü kişilere yüklemek"],"answer":1,"explanation":"Kriz iletişiminde tek ağızdan, hızlı, tutarlı ve şeffaf bilgi vermek güveni korur."}],"sources":[],"updatedAt":"2026-11-25T10:02:50.465Z"}